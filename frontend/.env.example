# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloud Run–hosted PDF generation service (see /backend). Region:
# asia-southeast1 (Singapore) — chosen for lower latency from Bangladesh
# than the us-central1 default, at the same "Always Free" quota (see
# Cloud Run's own pricing page: free-tier vCPU-seconds/GiB-seconds/requests
# are the same figure regardless of region, only the overage rate differs).
VITE_PDF_SERVICE_URL=https://amh-billing-pdf-xxxxx-as.a.run.app
# Shared secret this frontend sends as `Authorization: Bearer <key>` — must
# match the PDF_API_KEY environment variable set on the Cloud Run service
# itself (see backend/src/middleware/auth.js's own doc comment on why this
# is a single shared secret, not per-user credentials).
VITE_PDF_API_KEY=your-shared-secret-here